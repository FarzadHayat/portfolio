---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  photo?: ImageMetadata | string;
  Content: any;
  link?: string;
}

const { title, photo, Content, link } = Astro.props;
---

<section id="about" class="section section--about" aria-labelledby="about-title">
  <div class="container">
    <div class="panel about">
      {
        photo &&
          (typeof photo === "string" ? (
            <img class="about__photo" src={photo} alt="" loading="lazy" />
          ) : (
            <Image class="about__photo" src={photo} alt="" width={320} />
          ))
      }
      <div class="about__body">
        <h2 class="section__title" id="about-title">{title}</h2>
        <div class="prose">
          <Content />
        </div>
        {link && (
          <p>
            <a class="btn btn--sm" href={link} target="_blank" rel="noopener noreferrer">More about me</a>
          </p>
        )}
      </div>
    </div>
  </div>
</section>
