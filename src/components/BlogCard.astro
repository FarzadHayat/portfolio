---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const date = post.data.publishDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<article class="project-card post-card">
  <div class="project-card__media">
    <Image src={post.data.image} alt="" width={640} height={400} />
  </div>
  <div class="project-card__body">
    <h3 class="project-card__title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
    <p class="project-card__meta"><time datetime={post.data.publishDate.toISOString()}>{date}</time></p>
    <p class="project-card__desc">{post.data.description}</p>
  </div>
</article>
