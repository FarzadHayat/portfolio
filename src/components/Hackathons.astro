---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { formatDayRange } from "../utils/dates";

const entries = (await getCollection("hackathons")).sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime(),
);
---

<section id="hackathons" class="section section--alt section--hackathons" aria-labelledby="hackathons-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="hackathons-title">Hackathons</h2>
    </header>
    <ul class="hackathon-list">
      {
        entries.map(({ data }) => (
          <li>
            <article class="hackathon">
              {data.logo && (
                <figure class="hackathon__media">
                  <Image src={data.logo} alt="" width={480} />
                </figure>
              )}
              <div class="hackathon__body">
                <h3 class="hackathon__title">{data.title}</h3>
                <p class="hackathon__meta">
                  <time datetime={data.startDate.toISOString()}>{formatDayRange(data.startDate, data.endDate)}</time>
                  <span class="hackathon__place">, {data.location}</span>
                </p>
                <p class="hackathon__desc">{data.description}</p>
                {data.project ? (
                  <p class="hackathon__links">
                    <a class="btn btn--sm" href={`/projects/${data.project.id}`}>
                      View project<span class="sr-only"> from {data.title}</span>
                    </a>
                  </p>
                ) : (
                  data.sourceLink && (
                    <p class="hackathon__links">
                      <a class="btn btn--sm" href={data.sourceLink} target="_blank" rel="noopener noreferrer">
                        View the code<span class="sr-only"> for {data.title}</span>
                      </a>
                    </p>
                  )
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
