---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getIcon } from "../utils/iconMapper";
import HeroDecor from "./HeroDecor.astro";

interface Props {
  hero: {
    name: string;
    title: string;
    description: string;
    avatar: ImageMetadata | string;
    location?: string;
    socialLinks: Array<{ url: string; icon: string; label: string }>;
  };
  showQuizCta?: boolean;
}

const { hero, showQuizCta } = Astro.props;

// "G'day 👋 I'm Farzad Hayat" -> greeting + name, so the name can be the headline.
const split = hero.name.match(/^(.*?\bI['’]m)\s+(.+)$/);
const greeting = split ? split[1] : "";
const name = split ? split[2] : hero.name;
const roles = hero.title.split("|").map((r) => r.trim()).filter(Boolean);
const isExternal = (url: string) => /^https?:/.test(url);
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <HeroDecor />
  <div class="container hero__inner">
    <div class="hero__text">
      {greeting && <p class="hero__greeting">{greeting}</p>}
      <h1 class="hero__name" id="hero-name">{name}</h1>
      <p class="hero__title">
        {roles.map((role) => <span class="hero__role">{role}</span>)}
      </p>
      {hero.location && <p class="hero__location">{hero.location}</p>}
      <p class="hero__bio">{hero.description}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#projects">See projects</a>
        <a class="btn" href="/resume">Resume</a>
        {showQuizCta && <a class="btn btn--ghost" href="/quiz">Think you know me?</a>}
      </div>
      <ul class="social-links hero__links">
        {
          hero.socialLinks.map((link) => {
            const Icon = getIcon(link.icon as any);
            return (
              <li>
                <a
                  class="icon-btn"
                  href={link.url}
                  aria-label={link.label}
                  title={link.label}
                  {...(isExternal(link.url) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  <Icon aria-hidden="true" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
    <figure class="hero__portrait">
      {
        typeof hero.avatar === "string" ? (
          <img class="hero__photo" src={hero.avatar} alt={`Portrait of ${name}`} loading="eager" fetchpriority="high" />
        ) : (
          <Image class="hero__photo" src={hero.avatar} alt={`Portrait of ${name}`} width={560} height={560} loading="eager" fetchpriority="high" />
        )
      }
    </figure>
  </div>
</section>
