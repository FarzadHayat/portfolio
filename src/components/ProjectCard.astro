---
import { Image } from "astro:assets";
import { ExternalLink } from "@lucide/astro";
import GitHub from "./icons/GitHub.astro";
import SkillBadge from "./SkillBadge.astro";
import type { CollectionEntry } from "astro:content";
import { formatPeriod } from "../utils/dates";

interface Props {
  project: CollectionEntry<"projects">;
  lead?: boolean;
}

const { project, lead = false } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
---

<article class:list={["project-card", { "project-card--lead": lead }]}>
  <div class="project-card__media">
    <Image src={data.image} alt="" width={lead ? 1200 : 640} />
  </div>
  <div class="project-card__body">
    <h3 class="project-card__title"><a href={href}>{data.title}</a></h3>
    <p class="project-card__meta">
      <time datetime={data.startDate.toISOString()}>{formatPeriod(data.startDate, data.endDate)}</time>
      {!data.endDate && <span class="badge">Ongoing</span>}
    </p>
    <p class="project-card__desc">{data.description}</p>
    <ul class="chip-list" aria-label="Skills">
      {data.skills.slice(0, 5).map((skill) => <SkillBadge skill={skill} />)}
    </ul>
    {
      (data.demoLink || data.sourceLink) && (
        <div class="project-card__links">
          {data.demoLink && (
            <a class="btn btn--sm" href={data.demoLink} target="_blank" rel="noopener noreferrer">
              <ExternalLink aria-hidden="true" />
              Demo<span class="sr-only"> of {data.title}</span>
            </a>
          )}
          {data.sourceLink && (
            <a class="btn btn--sm" href={data.sourceLink} target="_blank" rel="noopener noreferrer">
              <GitHub />
              Source<span class="sr-only"> of {data.title}</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
