---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { sortProjects } from "../utils/sortProjects";

const entries = await getCollection("projects");
const current = sortProjects(entries.filter((p) => !p.data.archived));
const hasArchive = entries.some((p) => p.data.archived);
---

<section id="projects" class="section section--projects" aria-labelledby="projects-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="projects-title">Projects</h2>
    </header>
    <ul class="project-grid">
      {current.map((project, i) => (
        <li class:list={{ "project-grid__lead": i === 0 }}>
          <ProjectCard project={project} lead={i === 0} />
        </li>
      ))}
    </ul>
    {
      hasArchive && (
        <p class="section__more">
          <a class="btn" href="/projects">Earlier projects</a>
        </p>
      )
    }
  </div>
</section>
