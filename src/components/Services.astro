---
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="section section--services" aria-labelledby="services-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="services-title">Services</h2>
      <p class="section__intro">
        I take on projects for businesses. I use AI agents to work fast, and I check and test every change myself.
      </p>
    </header>
    <ul class="project-grid">
      {
        services.map(({ data }) => (
          <li>
            <article class="project-card">
              <div class="project-card__body">
                <h3 class="project-card__title">{data.title}</h3>
                <p class="project-card__desc">{data.summary}</p>
                <p class="project-card__meta">
                  <span><strong>Done before:</strong> {data.proof}</span>
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="section__more">
      <a class="btn btn--primary" href="https://cal.com/farzadhayat" target="_blank" rel="noopener noreferrer">Book a call</a>
      <a class="btn" href="mailto:hello@farzadhayat.dev">Email me</a>
    </p>
  </div>
</section>
