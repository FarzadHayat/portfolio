---
import { Menu } from "@lucide/astro";

const isHome = Astro.url.pathname === "/";
const base = isHome ? "" : "/";
const links = [
  { href: `${base}#services`, label: "Services" },
  { href: `${base}#projects`, label: "Projects" },
  { href: `${base}#experience`, label: "Experience" },
  { href: `${base}#hackathons`, label: "Hackathons" },
  { href: "/resume", label: "Resume" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">Farzad Hayat</a>
    <nav class="site-nav" aria-label="Main">
      <!-- On phones the list becomes a dropdown (a native popover). -->
      <button type="button" class="icon-btn site-nav__toggle" popovertarget="site-menu" aria-label="Menu">
        <Menu aria-hidden="true" />
      </button>
      <ul id="site-menu" class="site-nav__list" popover>
        {
          links.map((link) => (
            <li>
              <a class="site-nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Close the dropdown after a link is picked (same-page links do not reload).
  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest("#site-menu a");
    const menu = document.getElementById("site-menu");
    if (link && menu?.matches(":popover-open")) menu.hidePopover();
  });
</script>
