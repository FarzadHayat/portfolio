---
import Spotify from "./Spotify.astro";

interface Props {
  url: string;
}

const { url } = Astro.props;
---

<section id="playlist" class="section section--playlist" aria-labelledby="playlist-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="playlist-title">On repeat</h2>
      <p class="section__intro">My favourite playlist right now.</p>
    </header>
    <Spotify url={url} />
  </div>
</section>
