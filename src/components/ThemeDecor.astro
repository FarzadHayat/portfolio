---
// Renders every theme's optional Decor.astro (fixed page background) and
// shows only the active one. A theme adds decoration by creating
// src/themes/<id>/Decor.astro; nothing else needs to change.
const modules = import.meta.glob<{ default: any }>("../themes/*/Decor.astro", {
  eager: true,
});
const layers = Object.entries(modules).map(([path, mod]) => ({
  id: path.split("/")[2],
  Component: mod.default,
}));
const css = layers
  .map(({ id }) => `html[data-design="${id}"] [data-decor="${id}"]{display:block}`)
  .join("");
---

{
  layers.length > 0 && (
    <div class="theme-decor" aria-hidden="true">
      {layers.map(({ id, Component }) => (
        <div class="theme-decor__layer" data-decor={id}>
          <Component />
        </div>
      ))}
    </div>
  )
}
<style is:inline set:html={css}></style>
