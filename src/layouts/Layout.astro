---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeDock from "../components/ThemeDock.astro";
import ThemeDecor from "../components/ThemeDecor.astro";
import { getEntry } from "astro:content";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import {
  themes,
  getTheme,
  THEME_COOKIE,
  THEME_QUEUE_COOKIE,
} from "../themes/registry";

const generalEntry = await getEntry("general", "index");
const general = generalEntry!.data;

const siteName = "Farzad Hayat";

interface Props {
  title?: string;
  description?: string;
}

const {
  title: pageTitle = siteName,
  description = "Farzad Hayat, agent-native software engineer in Brisbane.",
} = Astro.props;

const title =
  pageTitle === siteName || pageTitle.includes(siteName)
    ? pageTitle
    : `${pageTitle} | ${siteName}`;

const origin = Astro.url.origin;

// Set by src/middleware.ts on server-rendered pages. Prerendered pages leave
// it empty and the boot script below picks the theme before first paint.
const theme = getTheme(Astro.locals.design);

const bootData = {
  cookie: THEME_COOKIE,
  queueCookie: THEME_QUEUE_COOKIE,
  themes: themes.map((t) => ({ id: t.id, scheme: t.scheme, fonts: t.fonts ?? "", bg: t.preview.bg })),
};
---

<!doctype html>
<html
  lang="en"
  data-design={theme?.id}
  data-scheme={theme?.scheme}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme?.preview.bg ?? "#f7f7f8"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline define:vars={{ bootData }}>
      // Prerendered pages: keep this visit's theme, or advance the shuffle bag, before first paint.
      (function () {
        var root = document.documentElement;
        if (root.dataset.design) return;
        var list = bootData.themes;
        var find = function (id) {
          for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i];
        };
        var readCookie = function (name) {
          var match = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
          return match ? decodeURIComponent(match[1]) : "";
        };
        var writeCookie = function (name, value) {
          document.cookie = name + "=" + encodeURIComponent(value) + "; path=/; samesite=lax";
        };
        var parseQueue = function (raw) {
          if (!raw) return [];
          try {
            var parsed = JSON.parse(raw);
            if (!Array.isArray(parsed)) return [];
            var valid = {};
            for (var i = 0; i < list.length; i++) valid[list[i].id] = true;
            return parsed.filter(function (id) {
              return typeof id === "string" && valid[id];
            });
          } catch (e) {
            return [];
          }
        };
        var shuffle = function (ids) {
          var next = ids.slice();
          for (var i = next.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = next[i];
            next[i] = next[j];
            next[j] = tmp;
          }
          return next;
        };
        var ids = list.map(function (item) {
          return item.id;
        });
        // Same rules as nextThemeFromBag in src/themes/registry.ts.
        var fill = function (q, recent) {
          q = q.slice();
          while (q.length < ids.length) {
            var tail = recent.concat(q).slice(-6);
            var fresh = shuffle(ids);
            q = q.concat(
              fresh.filter(function (id) { return tail.indexOf(id) < 0; }),
              fresh.filter(function (id) { return tail.indexOf(id) >= 0; }),
            );
          }
          return q;
        };
        var param = new URLSearchParams(location.search).get("theme");
        var previous = readCookie(bootData.cookie);
        var queue = parseQueue(readCookie(bootData.queueCookie));
        var t = find(param);
        if (t) {
          var at = queue.indexOf(t.id);
          if (at >= 0) queue.splice(at, 1);
        } else if (find(previous)) {
          t = find(previous);
        } else {
          queue = fill(queue, previous ? [previous] : []);
          var pick = 0;
          for (var k = 0; k < queue.length; k++) {
            if (queue[k] !== previous) { pick = k; break; }
          }
          var nextId = queue.splice(pick, 1)[0];
          queue = fill(queue, [nextId]);
          t = find(nextId) || list[0];
        }
        writeCookie(bootData.cookie, t.id);
        writeCookie(bootData.queueCookie, JSON.stringify(queue));
        root.dataset.design = t.id;
        root.dataset.scheme = t.scheme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", t.bg);
        if (t.fonts) {
          var link = document.createElement("link");
          link.id = "theme-fonts";
          link.rel = "stylesheet";
          link.href = t.fonts;
          document.head.appendChild(link);
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {theme?.fonts && <link id="theme-fonts" rel="stylesheet" href={theme.fonts} />}

    <SpeedInsights />
    <Analytics />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={`${origin}/images/og_home.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/images/og_home.png`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <ThemeDecor />
      <SiteHeader />
      <main id="main" class="page__main" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>

    {general.enableThemeSelector && <ThemeDock />}

    <script is:inline type="application/json" id="theme-data" set:html={JSON.stringify(themes)} />
    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
