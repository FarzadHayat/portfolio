---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import SkillBadge from "../components/SkillBadge.astro";
import GitHub from "../components/icons/GitHub.astro";
import { ArrowLeft, ExternalLink, Presentation, Download } from "@lucide/astro";
import { formatPeriod } from "../utils/dates";

interface Props {
  title: string;
  description: string;
  startDate: Date;
  endDate?: Date;
  image: any;
  skills: string[];
  demoLink?: string;
  slidesLink?: string;
  sourceLink?: string;
  downloadLink?: string;
}

const { title, description, startDate, endDate, image, skills, demoLink, slidesLink, sourceLink, downloadLink } =
  Astro.props;

function duration(start: Date, end?: Date) {
  const to = end || new Date();
  const months = (to.getFullYear() - start.getFullYear()) * 12 + (to.getMonth() - start.getMonth());
  if (months < 1) return "Less than a month";
  if (months < 12) return months === 1 ? "1 month" : `${months} months`;
  const years = Math.floor(months / 12);
  const rest = months % 12;
  const y = `${years} year${years > 1 ? "s" : ""}`;
  return rest ? `${y}, ${rest} month${rest > 1 ? "s" : ""}` : y;
}
---

<Layout title={title} description={description}>
  <article class="container article article--project">
    <header class="page-head">
      <a class="back-link" href="/projects"><ArrowLeft aria-hidden="true" />All projects</a>
      <h1 class="page-head__title">{title}</h1>
      <p class="page-head__intro">{description}</p>
      <p class="page-head__meta">
        <time datetime={startDate.toISOString()}>{formatPeriod(startDate, endDate)}</time>
        <span>{duration(startDate, endDate)}</span>
        {!endDate && <span class="badge">Ongoing</span>}
      </p>
      {
        (demoLink || slidesLink || sourceLink || downloadLink) && (
          <div class="page-head__actions">
            {demoLink && (
              <a class="btn btn--primary" href={demoLink} target="_blank" rel="noopener noreferrer">
                <ExternalLink aria-hidden="true" />Live demo
              </a>
            )}
            {slidesLink && (
              <a class="btn" href={slidesLink} target="_blank" rel="noopener noreferrer">
                <Presentation aria-hidden="true" />Slides
              </a>
            )}
            {sourceLink && (
              <a class="btn" href={sourceLink} target="_blank" rel="noopener noreferrer">
                <GitHub />Source
              </a>
            )}
            {downloadLink && (
              <a class="btn" href={downloadLink}>
                <Download aria-hidden="true" />Download
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      image && (
        <figure class="cover-image">
          <Image src={image} alt="" width={1200} loading="eager" />
        </figure>
      )
    }

    {
      skills.length > 0 && (
        <section class="panel stack-panel" aria-labelledby="stack-title">
          <h2 class="stack-panel__title" id="stack-title">Built with</h2>
          <ul class="chip-list">
            {skills.map((skill) => <SkillBadge skill={skill} />)}
          </ul>
        </section>
      )
    }

    <div class="prose prose-lg article__body">
      <slot />
    </div>

    <p class="article__foot">
      <a class="btn" href="/projects">All projects</a>
    </p>
  </article>
</Layout>
