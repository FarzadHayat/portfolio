---
import Layout from "../layouts/Layout.astro";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;

// Log the full error on the server only. Never show server details to visitors.
if (error instanceof Error) {
  console.error("500 Server Error:", {
    message: error.message,
    stack: error.stack,
    timestamp: new Date().toISOString(),
  });
}
---

<Layout title="Server error" description="Something went wrong on the server.">
  <div class="container error-page">
    <header class="page-head">
      <p class="error-page__code">500</p>
      <h1 class="page-head__title">Something went wrong</h1>
      <p class="page-head__intro">The server could not load this page. Try again in a moment.</p>
      <div class="page-head__actions">
        <a class="btn btn--primary" href="/">Go home</a>
      </div>
    </header>
  </div>
</Layout>
