---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import { sortProjects } from "../../utils/sortProjects";

const projects = await getCollection("projects");

// Ongoing projects first, then by end date
const sortedProjects = sortProjects(projects);
const currentProjects = sortedProjects.filter((p) => !p.data.archived);
const archivedProjects = sortedProjects.filter((p) => p.data.archived);
---

<Layout
  title="Projects"
  description="Explore my latest projects and work"
>
  <main class="max-w-6xl mx-auto px-6 py-28">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4">Projects</h1>
      <p class="text-xl text-base-content/70">
        A collection of projects I've worked on, showcasing my skills and
        experience.
      </p>
    </div>

    <!-- Back to Home -->
    <div class="mb-8">
      <a href="/" class="btn btn-ghost btn-sm rounded-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Projects Grid -->
    {
      currentProjects.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-2xl text-base-content/60">
            No projects yet. Check back soon!
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {currentProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }

    {
      archivedProjects.length > 0 && (
        <details class="mt-20">
          <summary class="btn btn-ghost rounded-full">
            Archive: earlier projects ({archivedProjects.length})
          </summary>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
            {archivedProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </details>
      )
    }
  </main>
</Layout>
