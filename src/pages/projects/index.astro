---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import { sortProjects } from "../../utils/sortProjects";
import { ArrowLeft } from "@lucide/astro";

const sorted = sortProjects(await getCollection("projects"));
const current = sorted.filter((p) => !p.data.archived);
const archived = sorted.filter((p) => p.data.archived);
---

<Layout title="Projects" description="Projects by Farzad Hayat, from current work to earlier university builds.">
  <div class="container">
    <header class="page-head">
      <a class="back-link" href="/"><ArrowLeft aria-hidden="true" />Home</a>
      <h1 class="page-head__title">Projects</h1>
    </header>
    <ul class="project-grid">
      {current.map((p) => <li><ProjectCard project={p} /></li>)}
    </ul>
    {
      archived.length > 0 && (
        <section class="section section--archive" aria-labelledby="archive-title">
          <header class="section__head">
            <h2 class="section__title" id="archive-title">Earlier projects</h2>
          </header>
          <ul class="project-grid">
            {archived.map((p) => <li><ProjectCard project={p} /></li>)}
          </ul>
        </section>
      )
    }
  </div>
</Layout>
