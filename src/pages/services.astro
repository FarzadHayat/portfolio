---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import { getIcon } from "../utils/iconMapper";

const hero = (await getEntry("hero", "index"))!.data;
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const bookingUrl = "https://cal.com/farzadhayat";
const email = "mailto:hello@farzadhayat.dev";
---

<!-- One fixed, plain theme here: clients should not land on a playful one. -->
<Layout
  title="IT and AI services in Brisbane"
  description="Websites, AI agents, upgrades and security fixes, automation and cloud setup for businesses, by Farzad Hayat in Brisbane."
  design="clay"
>
  <div class="container">
    <header class="page-head">
      <h1 class="page-head__title">Services</h1>
      <div class="service-intro">
        <Image class="service-intro__photo" src={hero.avatar} alt="Farzad Hayat" width={192} height={192} />
        <p class="page-head__intro">
          I'm Farzad, a software engineer in Brisbane. I take on projects for businesses. I use AI agents to work
          fast, and I check and test every change myself. You get a fixed quote before any work starts.
        </p>
      </div>
      <div class="page-head__actions">
        <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a>
        <a class="btn" href={email}>Email me</a>
      </div>
    </header>
    <ul class="project-grid">
      {
        services.map(({ data }) => {
          const Icon = getIcon(data.icon);
          return (
            <li>
              <article class="project-card">
                <div class="project-card__body">
                  <h2 class="project-card__title service-title">
                    <span class="service-icon"><Icon aria-hidden="true" /></span>
                    {data.title}
                  </h2>
                  <p class="project-card__desc">{data.summary}</p>
                  <p class="project-card__meta">
                    <span><strong>Done before:</strong> {data.proof}</span>
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
    <p class="section__more">
      <a class="btn btn--primary" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a free 30-minute call</a>
      <a class="btn" href={email}>Email me</a>
    </p>
  </div>
</Layout>
