---
// Glass: a soft, slowly drifting colour field (jacaranda, river teal,
// dusk pink, night blue) that the frosted panels float over.
// Pure CSS gradients, styled in theme.css.
---

<div class="glass-field">
  <span class="glass-orb glass-orb--jacaranda"></span>
  <span class="glass-orb glass-orb--river"></span>
  <span class="glass-orb glass-orb--dusk"></span>
  <span class="glass-orb glass-orb--night"></span>
</div>
